                </text>
            </list-item>
            <list-item class="color-list-item" type="item">
                <scroll class="color-scroll" scroll-x="true" scroll-y="false">
                    <div class="color-row">
                        <div class="color-item {{selectedBackgroundColor === '#000000' ? 'color-item-active' : ''}}" @click="selectBackgroundColor('#000000')" style="background-color: #000000;"></div>
                        <div class="color-item {{selectedBackgroundColor === '#1C1C1E' ? 'color-item-active' : ''}}" @click="selectBackgroundColor('#1C1C1E')" style="background-color: #1C1C1E;"></div>
                        <div class="color-item {{selectedBackgroundColor === '#2D3748' ? 'color-item-active' : ''}}" @click="selectBackgroundColor('#2D3748')" style="background-color: #2D3748;"></div>
                        <div class="color-item {{selectedBackgroundColor === '#F5E6C8' ? 'color-item-active' : ''}}" @click="selectBackgroundColor('#F5E6C8')" style="background-color: #F5E6C8;"></div>
                        <div class="color-item {{selectedBackgroundColor === '#FFF7E6' ? 'color-item-active' : ''}}" @click="selectBackgroundColor('#FFF7E6')" style="background-color: #FFF7E6;"></div>
                        <div class="color-item {{selectedBackgroundColor === '#FFF1F2' ? 'color-item-active' : ''}}" @click="selectBackgroundColor('#FFF1F2')" style="background-color: #FFF1F2;"></div>
                        <div class="color-item {{selectedBackgroundColor === '#FFF9C4' ? 'color-item-active' : ''}}" @click="selectBackgroundColor('#FFF9C4')" style="background-color: #FFF9C4;"></div>
                        <div class="color-item {{selectedBackgroundColor === '#C7EDCC' ? 'color-item-active' : ''}}" @click="selectBackgroundColor('#C7EDCC')" style="background-color: #C7EDCC;"></div>
                        <div class="color-item {{selectedBackgroundColor === '#E6FFFA' ? 'color-item-active' : ''}}" @click="selectBackgroundColor('#E6FFFA')" style="background-color: #E6FFFA;"></div>
                        <div class="color-item {{selectedBackgroundColor === '#DCEBFF' ? 'color-item-active' : ''}}" @click="selectBackgroundColor('#DCEBFF')" style="background-color: #DCEBFF;"></div>
                        <div class="color-item {{selectedBackgroundColor === '#EEF2FF' ? 'color-item-active' : ''}}" @click="selectBackgroundColor('#EEF2FF')" style="background-color: #EEF2FF;"></div>
                        <div class="color-item {{selectedBackgroundColor === '#F3E8FF' ? 'color-item-active' : ''}}" @click="selectBackgroundColor('#F3E8FF')" style="background-color: #F3E8FF;"></div>
                        <div class="color-item {{selectedBackgroundColor === '#FAFAFA' ? 'color-item-active' : ''}}" @click="selectBackgroundColor('#FAFAFA')" style="background-color: #FAFAFA;"></div>
                    </div>
                </scroll>
            </list-item>
        </list>

        <img static src="/common/images/set.png" @click="reset()" class="header-more"/>
    </div>
</template>

<script>
import router from '@system.router'
import storage from '../../utils/storage.js'

const DEFAULT_FONT_COLOR = '#FFFFFF'
const DEFAULT_BACKGROUND_COLOR = '#000000'

export default {
    private: {
        selectedFontColor: DEFAULT_FONT_COLOR,
        selectedBackgroundColor: DEFAULT_BACKGROUND_COLOR
    },

    onInit() {
        this.loadTheme()
    },

    loadTheme() {
        storage.get({
            key: 'EBOOK_FONT_COLOR',
            success: (data) => {
                if (data) this.selectedFontColor = data
            },
            fail: () => {
                this.selectedFontColor = DEFAULT_FONT_COLOR
            }
        })

        storage.get({
            key: 'EBOOK_BACKGROUND_COLOR',
            success: (data) => {
                if (data) this.selectedBackgroundColor = data
            },
            fail: () => {
                this.selectedBackgroundColor = DEFAULT_BACKGROUND_COLOR
            }
        })
    },

    selectFontColor(color) {
        this.selectedFontColor = color
        storage.set({
            key: 'EBOOK_FONT_COLOR',
            value: color
        })
    },

    selectBackgroundColor(color) {
        this.selectedBackgroundColor = color
        storage.set({
            key: 'EBOOK_BACKGROUND_COLOR',
            value: color
        })
    },

    reset() {
        this.selectedFontColor = DEFAULT_FONT_COLOR
        this.selectedBackgroundColor = DEFAULT_BACKGROUND_COLOR
        storage.set({ key: 'EBOOK_FONT_COLOR', value: DEFAULT_FONT_COLOR })
        storage.set({ key: 'EBOOK_BACKGROUND_COLOR', value: DEFAULT_BACKGROUND_COLOR })
        router.back()
    }
}
</script>

