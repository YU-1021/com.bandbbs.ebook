                        <div class="color-item {{selectedFontColor === '#B8C0CC' ? 'color-item-active' : ''}}" @click="selectFontColor('#B8C0CC')" style="background-color: #B8C0CC;"></div>
                        <div class="color-item {{selectedFontColor === '#2B2B2B' ? 'color-item-active' : ''}}" @click="selectFontColor('#2B2B2B')" style="background-color: #2B2B2B;"></div>
                        <div class="color-item {{selectedFontColor === '#8B4513' ? 'color-item-active' : ''}}" @click="selectFontColor('#8B4513')" style="background-color: #8B4513;"></div>
                        <div class="color-item {{selectedFontColor === '#0F172A' ? 'color-item-active' : ''}}" @click="selectFontColor('#0F172A')" style="background-color: #0F172A;"></div>
                    </div>
